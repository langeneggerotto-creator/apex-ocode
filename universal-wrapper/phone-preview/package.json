{
  "name": "@apex/ocode-dream-intake-phone-preview",
  "version": "0.3.1",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "phone": "expo start",
    "phone:tunnel": "expo start --tunnel",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "doctor": "npx expo-doctor@latest",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
    "export:android": "expo export --platform android --output-dir dist-android",
    "verify:exports": "node scripts/verify-exports.mjs",
    "verify": "npm run doctor && npm run typecheck && npm test && npm run export:ios && npm run export:android && npm run verify:exports"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.34",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=22"
  }
}
