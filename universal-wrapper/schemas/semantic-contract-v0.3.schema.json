{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex.local/ocode/semantic-contract-v0.3.schema.json",
  "title": "OCODE Platform-Neutral Semantic Contract v0.3",
  "type": "object",
  "required": ["contract_version", "contract_type", "intent_id", "module", "actors", "inputs", "state", "behaviors", "validation", "evidence", "non_goals"],
  "properties": {
    "contract_version": {"const": "0.3"},
    "contract_type": {"const": "platform_neutral_interaction_contract"},
    "intent_id": {"type": "string", "minLength": 1},
    "module": {"type": "object"},
    "actors": {"type": "array", "minItems": 1},
    "inputs": {"type": "array", "minItems": 1},
    "state": {"type": "array", "minItems": 1},
    "behaviors": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"type": "object", "required": ["id", "trigger", "result"]}
    },
    "validation": {"type": "array"},
    "evidence": {"type": "object"},
    "non_goals": {"type": "array"}
  },
  "additionalProperties": false
}
