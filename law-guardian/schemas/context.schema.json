{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex.local/ocode/law-guardian/context.schema.json",
  "title": "OCODE Law Guardian Task Context",
  "type": "object",
  "required": ["taskId", "domain", "mode", "riskLevel"],
  "properties": {
    "taskId": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "domain": {"type": "string", "minLength": 1},
    "mode": {"enum": ["EXPLORATION", "PROTOTYPE", "BUILD", "PILOT", "PRODUCTION", "HIGH_STAKES"]},
    "riskLevel": {"enum": ["LOW", "MODERATE", "HIGH", "CRITICAL", "UNKNOWN"]},
    "authorityLevel": {"type": "string"},
    "reversible": {"type": "boolean"},
    "affectedParties": {"type": "integer", "minimum": 1},
    "tags": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "commitments": {
      "type": "object",
      "properties": {
        "money": {"type": "number", "minimum": 0},
        "timeHours": {"type": "number", "minimum": 0},
        "externalWrites": {"type": "integer", "minimum": 0},
        "reputation": {"type": "number", "minimum": 0, "maximum": 5}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
