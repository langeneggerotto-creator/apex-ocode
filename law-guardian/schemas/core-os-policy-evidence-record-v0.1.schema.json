{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex.local/evidence-ledger/core-os-policy-evidence-record-v0.1.schema.json",
  "title": "APEX Core OS Policy Evidence Record v0.1",
  "description": "Portable evidence record for OCODE Law Guardian policy compilation and Core OS compliance traceability.",
  "type": "object",
  "required": ["record_id","record_type","schema_version","created_at","producer","subject","inherited_law","applicable_readiness_dimensions","implementation_status","policy_decision","evidence_references","unresolved_gaps","promotion_decision","reassessment_trigger","truth_boundary"],
  "properties": {
    "record_id": {"type":"string","minLength":1},
    "record_type": {"const":"CORE_OS_POLICY_EVIDENCE"},
    "schema_version": {"const":"0.1"},
    "created_at": {"type":"string","format":"date-time"},
    "producer": {"type":"object","required":["repository","module","version"],"properties":{"repository":{"type":"string","minLength":1},"module":{"type":"string","minLength":1},"version":{"type":"string","minLength":1},"commit":{"type":["string","null"]}},"additionalProperties":true},
    "subject": {"type":"object","required":["repository","project","module","artifact","version"],"properties":{"repository":{"type":"string"},"project":{"type":"string"},"module":{"type":"string"},"artifact":{"type":"string"},"version":{"type":"string"}},"additionalProperties":true},
    "inherited_law": {"type":"object","required":["registry_name","version","source_repository","registry_path","registry_sha256","contract_sha256","sync_status"],"properties":{"registry_name":{"type":"string"},"version":{"type":"string"},"source_repository":{"type":"string"},"registry_path":{"type":"string"},"registry_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"contract_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"source_blob_sha":{"type":["string","null"]},"sync_status":{"enum":["LIVE_VERIFIED","AUTHENTICATED_FETCH","PINNED_SNAPSHOT","STALE_SNAPSHOT","UNVERIFIED"]},"verified_at":{"type":["string","null"],"format":"date-time"},"drift_check_required":{"type":"boolean"}},"additionalProperties":true},
    "applicable_readiness_dimensions": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "implementation_status": {"enum":["IMPLEMENTED","PARTIALLY_IMPLEMENTED","DESIGNED_NOT_PROVEN","BLOCKED","UNKNOWN"]},
    "policy_decision": {"enum":["PROCEED","PROCEED_WITH_CONTROLS","HOLD_FOR_HUMAN_REVIEW","STOP","REJECT"]},
    "current_weakest_barrier": {"type":["string","null"]},
    "selected_gap_response": {"type":["string","null"]},
    "alternatives_route_fit": {"type":"array","items":{"type":"object"}},
    "ownership_portability_maintenance_recovery": {"type":"object"},
    "anti_paralysis_result": {"type":"object"},
    "evidence_references": {"type":"array","items":{"type":"string"}},
    "unresolved_gaps": {"type":"array","items":{"type":"string"}},
    "exceptions": {"type":"array","items":{"type":"object"}},
    "human_approval": {"type":"object","required":["required","status"],"properties":{"required":{"type":"boolean"},"status":{"enum":["NOT_REQUIRED","PENDING","APPROVED","REJECTED","EXPIRED"]},"approver":{"type":["string","null"]},"approved_at":{"type":["string","null"],"format":"date-time"}},"additionalProperties":true},
    "promotion_decision": {"enum":["PROMOTE","HOLD","REPAIR","STOP","REJECT","NOT_APPLICABLE"]},
    "reassessment_trigger": {"type":"string","minLength":1},
    "policy_receipt": {"type":"object"},
    "truth_boundary": {"type":"string","minLength":1}
  },
  "additionalProperties": false
}
