{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex.local/dreammusicforge/experience/schema-0.1.json",
  "title": "DreamMusicForge Experience Graph 0.1",
  "type": "object",
  "required": ["version", "duration_seconds", "transformation", "checkpoints"],
  "properties": {
    "version": {"const": "0.1"},
    "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
    "transformation": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "checkpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["t_start", "t_end", "primary_experience", "intensity"],
        "properties": {
          "t_start": {"type": "number", "minimum": 0},
          "t_end": {"type": "number", "exclusiveMinimum": 0},
          "primary_experience": {"type": "string", "minLength": 1},
          "intensity": {"type": "number", "minimum": 0, "maximum": 1},
          "attention_goal": {"type": "string"},
          "memory_goal": {"type": "string"},
          "intended_inference": {"type": "string"},
          "secondary_experiences": {"type": "array", "items": {"type": "string"}},
          "prohibited_inference": {"type": "array", "items": {"type": "string"}},
          "evidence_status": {"enum": ["VERIFIED", "MEASURED", "INFERRED", "POSSIBLE", "UNKNOWN"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
